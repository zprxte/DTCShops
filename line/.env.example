# คัดลอกเป็น line/.env แล้วใส่ค่า (ห้าม commit .env)

# ===== จำเป็น =====
# LINE Developers › Basic settings › Channel secret (32 ตัวอักษร)
LINE_CHANNEL_SECRET=
# LINE Developers › Messaging API › Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# ===== production (docker-compose.prod.yml --profile line) =====
# โดเมน HTTPS ของเว็บ — ใช้ทำลิงก์รูปในการ์ด (nginx เสิร์ฟ /uploads อยู่แล้ว)
# PUBLIC_BASE_URL=https://compare.example.co.th
# หน้าเว็บที่คนนอกเปิดได้ — ปุ่ม "ดูคุณสมบัติทั้งหมด" / "ดูบนเว็บ" และปุ่มเมนู "เปรียบเทียบสินค้า" (→ /compare) ใช้ค่านี้
# ต้องตั้งก่อน npm run setup · ตอนพัฒนาไม่ต้องตั้ง (npm run bot เปิดหน้าเว็บ dev ผ่าน tunnel ให้เอง)
# WEB_BASE_URL=https://compare.example.co.th

# ===== ไม่ต้องตั้ง (มีค่าเริ่มต้น) =====
# BOT_PORT=4100
# WEB_DEV_ORIGIN=http://localhost:5173   # หน้าเว็บ dev ที่ npm run bot เปิดผ่าน tunnel
# API_ORIGIN=http://localhost:4000      # compose ชุด prod ตั้งเป็น http://backend:4000 ให้เอง
