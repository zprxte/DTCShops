{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && cd ../backend && npm install && mkdir -p prisma && cp ../database/schema.prisma prisma/schema.prisma && npx prisma generate --schema prisma/schema.prisma",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "../backend/node_modules/.prisma/client/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "https://jcmfzpalzrdubjvuhqzq.supabase.co/storage/v1/object/public/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
