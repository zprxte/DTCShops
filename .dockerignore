# Root-level .dockerignore — the backend image's build context is now the
# repo root (see docker-compose.yml/backend/Dockerfile, 2026-09-02), so this
# replaces the old backend/.dockerignore. Keeps unrelated/huge directories
# out of the build context sent to the Docker daemon.
**/node_modules
.git
.claude
.agents
.vscode
docs
frontend
# แอปมือถือ (เพิ่มขอบเขต 15 ก.ย. 2026) — backend image ไม่ใช้ และ build/ของ native อาจใหญ่มาก
mobile
backend/uploads
database/dtcshops_db.sql
# รูปย่อที่ middleware/imageResize.js สร้างเอง — สร้างใหม่ได้เสมอ ไม่ต้องส่งเข้า build context
database/uploads/.cache
npm-debug.log
.env
